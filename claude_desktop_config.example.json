{
  "mcpServers": {
    "portal": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/TMYTiMidlY/portal-mcp-server.git",
        "ssh-remote-mcp",
        "--transport",
        "stdio"
      ],
      "env": {
        "SSH_HOSTS_YAML": "/path/to/your/hosts.yaml",
        "SSH_POLICIES_YAML": "/path/to/your/policies.yaml",
        "SSH_MCP_LOG_DIR": "/path/to/your/log/dir"
      }
    }
  }
}
